# =============================================================================
# ANTIGRAVITY ERP - Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================================

# Database (MySQL 8.0)
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="erp_arts_alu"
DB_PORT="3306"

# Prisma (Auto-generated from above)
DATABASE_URL="mysql://root:@localhost:3306/erp_arts_alu"

# Google API (for AI features)
GOOGLE_API_KEY="your-api-key-here"

# Python Backend
PYTHON_SERVICE_URL="http://localhost:8000"

# Node Backend
NODE_PORT=3000
NODE_ENV=development

# JWT Secret (generate a secure random string for production)
JWT_SECRET="change-me-in-production"
